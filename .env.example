# Per-expert models (GPT, Claude, Gemini, Llama, Mistral, DeepSeek, Grok, Qwen, Kimi) via OpenRouter.
# Create a key at https://openrouter.ai/keys . Without it every expert uses the free model.
OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=openai/gpt-4.1-mini
# SITE_URL=https://your-domain.vercel.app

# Signs login cookies (any long random string). Recommended in production.
AUTH_SECRET=

# Chat model: any OpenAI-compatible server.
#   text-generation-webui: start with --api  -> http://127.0.0.1:5000/v1
#   Ollama: http://127.0.0.1:11434/v1        LM Studio: http://127.0.0.1:1234/v1
# Leave LLM_BASE_URL empty to use the free Pollinations model; set it to "mock" for canned replies.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=local-model
# true if the model accepts images (multimodal / vision)
LLM_VISION=false
LLM_HISTORY_CHARS=12000

# Voice out (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Voice in (Whisper-compatible /audio/transcriptions)
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Pictures (AUTOMATIC1111 / Forge, start with --api)
SD_BASE_URL=
SD_STEPS=25

# Persistent storage (required on Vercel): add "Upstash for Redis" under Vercel -> Storage.
# Vercel injects these automatically (either naming works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Without Redis, data is stored as JSON files here (default ./data/companion)
COMPANION_DATA_DIR=
